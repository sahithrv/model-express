{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-express.local/schemas/model_express_compatibility_profile.v1.json",
  "title": "Model Express compatibility profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "model_express_compatibility_profile.v1"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/allow_rule"
      }
    },
    "metadata": {
      "$ref": "model_express_experiment_policy.v1.schema.json#/$defs/metadata"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "allow_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "effect",
        "selector"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "const": "allow"
        },
        "selector": {
          "oneOf": [
            {
              "$ref": "#/$defs/catalog_ids"
            },
            {
              "$ref": "#/$defs/catalog_attribute_values"
            }
          ]
        }
      }
    },
    "catalog_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "catalog",
        "ids"
      ],
      "properties": {
        "kind": {
          "const": "catalog_ids"
        },
        "catalog": {
          "$ref": "#/$defs/identifier"
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "catalog_attribute_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "catalog",
        "attribute",
        "values"
      ],
      "properties": {
        "kind": {
          "const": "catalog_attribute_values"
        },
        "catalog": {
          "$ref": "#/$defs/identifier"
        },
        "attribute": {
          "$ref": "#/$defs/identifier"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
