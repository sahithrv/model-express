MODEL_EXPRESS_ORCHESTRATOR_ADDR=127.0.0.1:8080
MODEL_EXPRESS_ALLOW_LAN=false
# Raw, cursor-safe execution-event SSE. This remains disabled until clients
# explicitly opt in; it is not authoritative for synthesized activity yet.
MODEL_EXPRESS_ACTIVITY_STREAM_V2_ENABLED=false
# Required only when MODEL_EXPRESS_ALLOW_LAN=true.
# MODEL_EXPRESS_API_TOKEN=replace-with-generated-token
# Remote training orchestrator URLs/tunnels also require MODEL_EXPRESS_ALLOW_LAN=true plus MODEL_EXPRESS_API_TOKEN.
# Tunnel URLs are only for explicit remote training sessions; do not tunnel DB, MLflow, or MinIO console ports.
# MODAL_ORCHESTRATOR_URL=https://your-8080-tunnel.trycloudflare.com
# MODAL_S3_ENDPOINT_URL=https://your-scoped-storage-endpoint.example.com
# Modal refuses the local MinIO root credential pair unless MODEL_EXPRESS_ALLOW_MODAL_ROOT_STORAGE=true is set explicitly.
# Prefer managed storage with scoped credentials or presigned access for remote training.
# MODEL_EXPRESS_MODAL_AWS_ACCESS_KEY_ID=replace-with-scoped-access-key
# MODEL_EXPRESS_MODAL_AWS_SECRET_ACCESS_KEY=replace-with-scoped-secret-key
AWS_ACCESS_KEY_ID=model_express
AWS_SECRET_ACCESS_KEY=model_express_password
AWS_DEFAULT_REGION=us-east-1
MODAL_GPU_TYPE=T4
MODEL_EXPRESS_MAX_AUTO_WORKERS=4
# Best-effort attempt progress is enabled by default. Set false to disable its
# callbacks while retaining legacy stage/metric reporting and training behavior.
MODEL_EXPRESS_PROGRESS_REPORTING_ENABLED=true
# Unchanged observations are sent at most once per interval; stage transitions
# and changed current/total boundaries bypass this throttle.
MODEL_EXPRESS_PROGRESS_HEARTBEAT_SECONDS=15
# Progress callbacks use their own short, hard-capped timeout/retry budget.
MODEL_EXPRESS_PROGRESS_REPORT_TIMEOUT_SECONDS=5
MODEL_EXPRESS_PROGRESS_REPORT_MAX_ATTEMPTS=3
MODEL_EXPRESS_LLM_MODEL=gpt-5.4-mini
MODEL_EXPRESS_VISUAL_LLM_MODEL=gpt-5.4-mini
MODEL_EXPRESS_LLM_API_STYLE=responses
MODEL_EXPRESS_LLM_STORED_RESPONSES=true
# Optional audited pricing snapshot. Leave all six unset to record provider
# usage without deriving cost; rates apply only to the bound provider/model.
# MODEL_EXPRESS_LLM_PRICING_VERSION=provider-model-YYYY-MM-DD
# MODEL_EXPRESS_LLM_PRICING_PROVIDER=openai
# MODEL_EXPRESS_LLM_PRICING_MODEL=gpt-5.4-mini
# MODEL_EXPRESS_LLM_INPUT_USD_PER_MILLION_TOKENS=
# MODEL_EXPRESS_LLM_CACHED_INPUT_USD_PER_MILLION_TOKENS=
# MODEL_EXPRESS_LLM_OUTPUT_USD_PER_MILLION_TOKENS=
MODEL_EXPRESS_PLANNER_STATIC_PROMPT_VERSION=compact_v1
MODEL_EXPRESS_PLANNER_CONTEXT_VERSION=v2
# strict is the default. Set relaxed only as the observable one-release rollback;
# shadow_strict remains available for measurement without changing scheduling.
MODEL_EXPRESS_PLANNER_VALIDATION_MODE=strict
# Guarded planner-policy rollout is opt-in. Keep these flags present so an
# operator can advance 5 -> 25 -> 50 -> 100 or roll back without a deploy.
MODEL_EXPRESS_PLANNER_ROLLOUT_ENABLED=false
MODEL_EXPRESS_PLANNER_ROLLOUT_POLICY_ID=planner_policy_ranker_v2_candidate
MODEL_EXPRESS_PLANNER_ROLLOUT_LAST_APPROVED_POLICY_ID=planner_policy_ranker_v1_approved
MODEL_EXPRESS_PLANNER_ROLLOUT_STAGE_PERCENT=5
MODEL_EXPRESS_PLANNER_ROLLOUT_STATE=active
MODEL_EXPRESS_PLANNER_ROLLOUT_DIMENSIONS=ranker
MODEL_EXPRESS_PLANNER_ROLLOUT_FACTORIAL=false
MODEL_EXPRESS_PLANNER_ROLLOUT_ROLLBACK=false
MODEL_EXPRESS_PLANNER_ROLLOUT_RANKER_VERSION=candidate_ranker_v2_v1
# Set only when that single dimension is selected (or factorial=true explicitly).
# MODEL_EXPRESS_PLANNER_ROLLOUT_PROMPT_VERSION=compact_v1
# MODEL_EXPRESS_PLANNER_ROLLOUT_CONTEXT_VERSION=v2
# MODEL_EXPRESS_PLANNER_ROLLOUT_RETRIEVAL_VARIANT=enabled
# Fidelity PR3 defaults to reporting would-block findings without changing scheduling.
# Switch to enforce only after reviewing execution_validation_finding telemetry.
MODEL_EXPRESS_EXECUTION_VALIDATION_MODE=enforce
MODEL_EXPRESS_LEGACY_EXECUTION_EVIDENCE_POLICY=allow
MODEL_EXPRESS_MEMORY_DISTILLED_FIRST=true
MODEL_EXPRESS_MEMORY_EMBEDDING_MAX_CALLS_PER_DAY=100
MODEL_EXPRESS_MEMORY_BACKFILL_LIMIT=50
MODEL_EXPRESS_MEMORY_RETRIEVAL_QUERY_CACHE_TTL_SECONDS=3600
MODEL_EXPRESS_MEMORY_LOG_ONLY_EMBEDDINGS=false
